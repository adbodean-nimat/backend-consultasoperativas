# true por defecto: valida y convierte móviles argentinos a 549...
# false: conserva los dígitos de un único número para pruebas con Meta.
# Con false, 3455281448 se envía como 3455281448: cargar el formato completo.
WEP_VALIDA_NRO=true

# WEP - aviso de entrega PROGRAMADA (dejar vacío hasta tener plantilla aprobada)
WEP_WHATSAPP_TEMPLATE_PROGRAMADA=
WEP_WHATSAPP_TEMPLATE_PROGRAMADA_LANG=es_AR
# WEP - envío manual técnico. Debe coincidir con la plantilla aprobada en Meta.
WEP_WHATSAPP_TEMPLATE_PROGRAMADA_TEST=wep_programada_test
WEP_WHATSAPP_TEMPLATE_PROGRAMADA_TEST_LANG=es_AR
# WEP - aviso automático al iniciar el viaje y pasar la parada a EN_REPARTO.
WEP_WHATSAPP_TEMPLATE_EN_REPARTO=wep_en_reparto_test
# WEP - aviso manual del botón "Avisar cliente", con ETA y tracking.
WEP_WHATSAPP_TEMPLATE_EN_CAMINO=wep_en_camino_test
WEP_WHATSAPP_TEMPLATE_EN_CAMINO_LANG=es_AR
# Plantilla alternativa para ETA calculada hasta el barrio (mismo parámetro numérico y botón de tracking).
WEP_WHATSAPP_TEMPLATE_EN_CAMINO_ZONA=wep_en_camino_zona
# Google se usa sólo desde backend para geocodificación.
WEP_GEOCODING_PROVIDER=google
WEP_GOOGLE_GEOCODING_API_KEY=
WEP_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json
WEP_GEOCODING_TIMEOUT_MS=10000
# Activar temporalmente para diagnosticar solicitudes/resultados Google. Nunca registra el token.
WEP_GEOCODING_DEBUG=false
# Mantener false salvo que el contrato de Google permita persistir sus resultados.
WEP_GOOGLE_GEOCODING_ALLOW_PERSISTENT_CACHE=false
WEP_GEOCODING_DEFAULT_PROVINCE=ENTRE RIOS
WEP_GEOCODING_DEFAULT_CITY=CONCORDIA
WEP_GEOCODING_DEFAULT_COUNTRY=ARGENTINA
WEP_GEOCODING_COUNTRY_CODE=AR
# OpenRouteService/HeiGIT se usa sólo desde backend para calcular rutas.
WEP_ROUTING_PROVIDER=openrouteservice
WEP_ROUTING_API_KEY=
WEP_ROUTING_BASE_URL=https://api.heigit.org/openrouteservice
WEP_ROUTING_TIMEOUT_MS=10000
WEP_PUBLIC_TRACKING_URL=https://wep.nimat.com.ar/s
WEP_TRACKING_EXPIRATION_DAYS=2
